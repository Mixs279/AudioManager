{
    "manifest_version": 3,
    "name": "Audio Manager",
    "version": "1.4.0",
    "description": "A volume booster and multi-band equalizer.",
    "permissions": [
        "tabCapture",
        "activeTab",
        "tabs",
        "offscreen",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon128.png"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}